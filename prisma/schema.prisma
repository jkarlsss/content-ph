// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                       String               @id
  name                     String
  email                    String
  emailVerified            Boolean
  image                    String?
  createdAt                DateTime             @default(now())
  updatedAt                DateTime             @updatedAt
  lastActiveOrganizationId String? // denormalized pointer, not a hard FK constraint
  sessions                 Session[]
  accounts                 Account[]

  userChannels              UserChannel[]
  ideas                     Idea[]
  scheduledPosts            ScheduledPost[]
  subscriptions             Subscription[]

  @@unique([email])
  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String    @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime? @default(now())
  updatedAt  DateTime? @updatedAt

  @@map("verification")
}

// ==========================================
// 2. SOCIAL CHANNELS SYSTEM
// ==========================================

/// Seeded lookup table for supported networks
model ChannelType {
  id                       String               @id
  type           String        @unique // e.g., "TWITTER", "LINKEDIN"
  name           String        // e.g., "Twitter / X", "LinkedIn"
  color          String        // Hex or Tailwind color class
  characterLimit Int           @default(2200) @map("character_limit")
  createdAt      DateTime      @default(now()) @map("created_at")
  userChannels   UserChannel[]

  @@map("channel_types")
}

/// Tracks authenticated user social media handles and credentials
model UserChannel {
  id                       String               @id
  userId        String          
  channelTypeId String          @map("channel_type_id")
  handle        String      
  profileImage  String?         @map("profile_image") 
  profileUrl    String?         @map("profile_url")
  accessToken   String          @map("access_token")  
  isConnected   Boolean         @default(true) @map("is_connected")
  isActive      Boolean         @default(true) @map("is_active")
  createdAt     DateTime        @default(now()) @map("created_at")
  updatedAt     DateTime        @updatedAt @map("updated_at")
  
  // Relations
  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  channelType    ChannelType     @relation(fields: [channelTypeId], references: [id], onDelete: Cascade)

  scheduledPosts ScheduledPost[]

  @@map("user_channels")
}

// ==========================================
// 3. KANBAN BOARD / CONTENT IDEAS
// ==========================================

/// Lookup seed table for the Kanban board columns
model IdeaGroup {
  id        String   @id @default(uuid())
  name      String   @unique // "Unassigned", "To Do", "In Progress", "Done"
  createdAt DateTime @default(now()) @map("created_at")
  ideas     Idea[]

  @@map("idea_groups")
}

/// Stores brainstorming content cards managed on the Kanban board
model Idea {
  id          String    @id @default(uuid())
  userId      String    @map("user_id")
  groupId     String    @map("group_id")
  title       String
  description String?   @db.Text
  images      String[]  @default([]) // Array of image URLs hosted via Insforge storage
  tags        String[]  @default([])
  sortOrder   Int       @default(0) @map("sort_order")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  // Relations
  user  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  group IdeaGroup @relation(fields: [groupId], references: [id], onDelete: Restrict)

  @@map("ideas")
}

// ==========================================
// 4. POST SCHEDULING ENGINE
// ==========================================

/// Holds items queued up for the Inngest cron automated publishing jobs
model ScheduledPost {
  id            String    @id @default(uuid())
  userId        String    @map("user_id")
  userChannelId String    @map("user_channel_id")
  content       String    @db.Text
  images        String[]  @default([])
  scheduledAt   DateTime  @map("scheduled_at")
  timezone      String    @default("UTC")
  status        String    @default("PENDING") // e.g., PENDING, PUBLISHED, FAILED
  publishedAt   DateTime? @map("published_at")
  publishedUrl  String?   @map("published_url") // Direct link back to live social post
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  // Relations
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  userChannel UserChannel @relation(fields: [userChannelId], references: [id], onDelete: Cascade)

  @@map("scheduled_posts")
}

// ==========================================
// 5. BILLING & MONETIZATION
// ==========================================

/// Manages multi-tier application access restrictions (Free, Pro, Premium)
model Subscription {
  id                   String    @id @default(uuid())
  userId               String    @map("user_id")
  stripeCustomerId     String    @map("stripe_customer_id")
  stripeSubscriptionId String    @map("stripe_subscription_id")
  planTier             String    @default("FREE") @map("plan_tier") // FREE, PRO, PREMIUM
  status               String    @map("status") // active, canceled, past_due
  currentPeriodEnd     DateTime  @map("current_period_end")
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("subscriptions")
}