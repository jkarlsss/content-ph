// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                       String               @id
  name                     String
  email                    String
  emailVerified            Boolean
  image                    String?
  createdAt                DateTime             @default(now())
  updatedAt                DateTime             @updatedAt
  lastActiveOrganizationId String? // denormalized pointer, not a hard FK constraint
  sessions                 Session[]
  accounts                 Account[]
  organizations            OrganizationMember[]
  channels                 UserChannels[]
  schedulePosts            SchedulePosts[]
  ideas                    Idea[]
  metaConnection           MetaConnection?
  metaOAuthStates          MetaOAuthState[]

  @@unique([email])
  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String    @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime? @default(now())
  updatedAt  DateTime? @updatedAt

  @@map("verification")
}

model Organization {
  id      String               @id @default(cuid())
  name    String
  members OrganizationMember[]

  @@map("organization")
}

model OrganizationMember {
  id             String       @id @default(cuid())
  userId         String
  organizationId String
  role           Role         @default(MEMBER) // OWNER, ADMIN, MEMBER
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
  @@index([organizationId])
  @@map("organization_member")
}

model UserChannels {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  channelType ChannelType

  handle       String
  profileImage String
  accessToken  String
  isConnected  Boolean
  isActive     Boolean
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  schedulePosts SchedulePosts[]

  @@index([userId])
  @@index([channelType])
  @@map("user_channels")
}

model SchedulePosts {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  userChannelId String
  userChannel   UserChannels @relation(fields: [userChannelId], references: [id], onDelete: Cascade)

  content    String
  images     String[]
  scheduleAt DateTime
  timezone   String
  status     PostStatus
  publishAt  DateTime?
  publishUrl String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([userChannelId])
  @@map("schedule_posts")
}

/// A saved post brief — what the user filled into the Post Generator form,
/// plus whatever drafts were last generated for it. Ideas belong to a single
/// user; there is no sharing/collaboration model here yet.
model Idea {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // --- Brief fields (1:1 with PostBrief in post-schema.ts) ---------------
  title        String // user-facing name for this saved idea, NOT part of PostBrief
  businessName String?
  niche        String
  audience     String?

  platforms Platform[] // Postgres native array of the enum above
  postType  PostType
  tone      Tone
  postCount Int        @default(1)

  keyDetails String?
  cta        String?

  includeHashtags Boolean @default(true)
  includeEmojis   Boolean @default(true)

  // --- Last-generated drafts, if any --------------------------------------
  // Stored as JSON rather than a separate table: drafts are a snapshot tied
  // to one generation run, not independently queried/updated entities.
  // Shape: GeneratedPost[] from post-schema.ts, i.e.
  //   [{ id: string, platform: Platform, content: string }, ...]
  generatedPosts Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([userId, createdAt])
}

model MetaConnection {
  id             String     @id @default(cuid())
  userId         String     @unique
  user           User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  status         String     @default("ACTIVE") // ACTIVE, NEEDS_REAUTH, EXPIRED, etc.
  accessTokenEnc String     @db.Text // encrypted long-lived user token
  tokenExpiresAt DateTime? // optional: when the token expires (may be far in the future or null if non-expiring)
  lastSyncedAt   DateTime? // when we last fetched pages
  lastError      String?    @db.Text
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  pages          MetaPage[]
}

model MetaPage {
  id                         String         @id @default(cuid())
  connectionId               String
  connection                 MetaConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  pageId                     String         @unique // Facebook Page numeric ID
  pageName                   String
  accessTokenEnc             String         @db.Text // encrypted page access token (long-lived)
  instagramBusinessAccountId String? // optional Instagram linked account ID
  category                   String? // optional page category
  createdAt                  DateTime       @default(now())
  updatedAt                  DateTime       @updatedAt
}

model MetaOAuthState {
  id            String   @id @default(cuid())
  state         String   @unique
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  redirectAfter String? // URL to redirect after OAuth callback
  expiresAt     DateTime
  createdAt     DateTime @default(now())
}

enum ChannelType {
  INSTAGRAM
  FACEBOOK
  TWITTER
}

enum Platform {
  INSTAGRAM
  FACEBOOK
  TWITTER
  LINKEDIN
  TIKTOK
}

enum PostStatus {
  DRAFT
  SCHEDULED
  PUBLISHING
  PUBLISHED
  FAILED
  PARTIALLY_PUBLISHED
}

enum PostType {
  PROMOTIONAL
  ANNOUNCEMENT
  ENGAGEMENT
  EDUCATIONAL
  BEHIND_THE_SCENES
  TESTIMONIAL
  SEASONAL
}

enum Role {
  OWNER
  ADMIN
  MEMBER
}

enum SocialAccountStatus {
  NEEDS_RECONNECTION
  CONNECTED
}

/// Mirrors the `Tone` union driving TONE_META.
enum Tone {
  PROFESSIONAL
  CASUAL
  PLAYFUL
  LUXURY
  URGENT
  BOLD
  FRIENDLY
  WITTY
}
