// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String    @id
  name          String
  email         String
  emailVerified Boolean
  image         String?
  createdAt     DateTime
  updatedAt     DateTime
  lastActiveOrganizationId String?  // denormalized pointer, not a hard FK constraint
  sessions      Session[]
  accounts      Account[]
  organizations OrganizationMember[]
  metaConnections MetaConnection[]

  @@unique([email])
  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime
  updatedAt DateTime
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime
  updatedAt             DateTime

  @@map("account")
}

model Verification {
  id         String    @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime?
  updatedAt  DateTime?

  @@map("verification")
}


model Organization {
  id            String   @id @default(cuid())
  name          String
  members       OrganizationMember[]
  socialAccounts SocialAccount[]
  posts         Post[]
}

model OrganizationMember {
  id             String   @id @default(cuid())
  userId         String
  organizationId String
  role           Role     @default(MEMBER) // OWNER, ADMIN, MEMBER
  user           User     @relation(fields: [userId], references: [id])
  organization   Organization @relation(fields: [organizationId], references: [id])
}

model SocialAccount {
  id             String   @id @default(cuid())
  organizationId String
  platform       Platform // FACEBOOK, INSTAGRAM, TWITTER
  externalId     String   // page id / IG business account id / X user id
  name           String   // display name of the page/profile
  accessToken    String   @db.Text // ENCRYPTED
  refreshToken   String?  @db.Text
  tokenExpiresAt DateTime?
  status         SocialAccountStatus
  metadata       Json?    // platform-specific extras
  organization   Organization @relation(fields: [organizationId], references: [id])
  postTargets    PostTarget[]
}

model Post {
  id             String   @id @default(cuid())
  organizationId String
  authorId       String
  content        String   @db.Text
  mediaUrls      String[] // or a separate Media model
  status         PostStatus @default(DRAFT) // DRAFT, SCHEDULED, PUBLISHING, PUBLISHED, FAILED
  scheduledAt    DateTime?
  organization   Organization @relation(fields: [organizationId], references: [id])
  targets        PostTarget[]
  createdAt      DateTime @default(now())
}

// One post -> many platforms. Each target tracks its own status independently.
model PostTarget {
  id              String   @id @default(cuid())
  postId          String
  socialAccountId String
  status          PostStatus @default(SCHEDULED)
  platformPostId  String?  // ID returned after successful publish
  errorMessage    String?
  publishedAt     DateTime?
  post            Post @relation(fields: [postId], references: [id])
  socialAccount   SocialAccount @relation(fields: [socialAccountId], references: [id])
}

model MetaConnection {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  metaUserId String  // Meta's "me" id for the user who authorized the app

  // Tokens are stored ENCRYPTED (see lib/crypto.ts) — never store raw tokens.
  accessTokenEnc String  // long-lived user access token, encrypted
  tokenExpiresAt DateTime // when the long-lived token expires (~60 days)

  scopes    String[] // granted scopes, parsed from token response if available

  status    MetaConnectionStatus @default(ACTIVE)
  lastSyncedAt DateTime?
  lastError    String?

  pages     MetaPage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
}

enum MetaConnectionStatus {
  ACTIVE
  NEEDS_REAUTH // refresh failed / token revoked — user must reconnect
  REVOKED
}

// One row per Facebook Page (+ optionally linked IG business account)
// reachable by a given connection's user token.
model MetaPage {
  id           String   @id @default(cuid())
  connectionId String
  connection   MetaConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  pageId       String   // Facebook Page ID
  pageName     String

  // Page access tokens are long-lived already (derived from the long-lived
  // user token) but Meta can still invalidate them — keep encrypted + refreshable.
  pageAccessTokenEnc String

  instagramBusinessAccountId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([connectionId, pageId])
}

// Short-lived row to validate the OAuth `state` param on callback.
// TTL it (e.g. 10 min) via a cron/cleanup job or just check expiresAt.
model MetaOAuthState {
  state     String   @id
  userId    String
  redirectAfter String? // where to send the user once connect finishes
  createdAt DateTime @default(now())
  expiresAt DateTime
}


enum Platform {
  FACEBOOK
  INSTAGRAM
  TWITTER
}

enum PostStatus {
  DRAFT
  SCHEDULED
  PUBLISHING
  PUBLISHED
  FAILED
  PARTIALLY_PUBLISHED
}

enum Role {
  OWNER
  ADMIN 
  MEMBER
}

enum SocialAccountStatus {
  NEEDS_RECONNECTION
  CONNECTED
}

